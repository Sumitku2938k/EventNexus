# ==============================================================================
# EventNexus Environment Configuration Template
# Copy this file to '.env' for local development:
#   cp .env.example .env
# Never commit real credentials or actual secrets into version control.
# ==============================================================================

# Execution Environment Mode (development | production)
NODE_ENV=development

# Local Server Port
PORT=3000

# MongoDB Connection String
# Local MongoDB format:
#   MONGO_URI=mongodb://127.0.0.1:27017/collegeEvent
# MongoDB Atlas format:
#   MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster_address>/collegeEvent?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/collegeEvent

# Session Secret (Required in production - use a strong, cryptographically secure 64+ char random string)
SESSION_SECRET=your-secure-random-session-secret-here

# Production Database Seeding Guard
# Set to 'true' only when deliberately running init scripts in production. Default is 'false'.
ALLOW_SEED=false

# Optional Initial Seed Account Credentials (Used by init/admin-seed.js)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=replace_with_secure_admin_password
STUDENT_NAME=John Doe
STUDENT_EMAIL=student@college.edu
STUDENT_PASSWORD=replace_with_secure_student_password

# Cloudinary Media Storage (Prepared for Phase 2)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
