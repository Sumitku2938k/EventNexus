<% layout("layouts/boilerplate.ejs") -%>

<div class="row">
  <div class="col-lg-8 mx-auto">
    <% if (typeof success !== 'undefined' && success === 'registered') { %>
      <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i><strong>Success!</strong> You have successfully registered for this event.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } else if (typeof success !== 'undefined' && success === 'unregistered') { %>
      <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-info-circle me-2"></i>You have unregistered from this event.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error === 'already_registered') { %>
      <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>You are already registered for this event.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="event-detail-card">
      <span class="category-badge category-<%= event.category.toLowerCase() %>">
        <%= event.category %>
      </span>
      
      <h2 class="mt-3 mb-4"><%= event.name %></h2>
      <div class="text-center mb-4">
        <img src="<%= event.poster %>" alt="<%= event.name %> Poster" class="event-poster">
      </div>

      <div class="event-info">
        <div class="info-item">
          <strong><i class="fas fa-align-left me-2"></i> Description:</strong>
          <span><%= event.description %></span>
        </div>
        
        <div class="info-item">
          <strong><i class="fas fa-calendar me-2"></i> Date:</strong>
          <span><%= (event.date && !isNaN(new Date(event.date).getTime())) ? new Date(event.date).toDateString() : 'Date TBD' %></span>
        </div>
        
        <div class="info-item">
          <strong><i class="fas fa-map-marker-alt me-2"></i> Venue:</strong>
          <span><%= event.venue %></span>
        </div>
        
        <div class="info-item">
          <strong><i class="fas fa-rupee-sign me-2"></i> Registration Fee:</strong>
          <span>₹<%= event.registrationFee.toLocaleString("en-IN") %></span>
        </div>
        
        <div class="info-item">
          <strong><i class="fas fa-clock me-2"></i> Posted:</strong>
          <span><%= (event.createdAt && !isNaN(new Date(event.createdAt).getTime())) ? new Date(event.createdAt).toDateString() : 'N/A' %></span>
        </div>
      </div>
      
      <div class="action-buttons">
        <!-- Student Registration Button -->
        <% if (currentUser.isLoggedIn && currentUser.role === 'student') { %>
          <% if (isRegistered) { %>
            <form method="POST" action="/register/<%= event._id %>?_method=DELETE">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to unregister?');">
                <i class="fas fa-times-circle me-2"></i>Unregister
              </button>
            </form>
          <% } else { %>
            <form method="POST" action="/register/<%= event._id %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-success">
                <i class="fas fa-check-circle me-2"></i>Register for Event
              </button>
            </form>
          <% } %>
        <% } %>

        <!-- Admin Actions -->
        <% if (currentUser.role === 'admin') { %>
          <a href="/events/<%= event._id %>/edit" class="btn btn-warning">
            <i class="fas fa-edit me-2"></i>Edit Event
          </a>
          
          <form method="POST" action="/events/<%= event._id %>?_method=DELETE" style="display: inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this event?');">
              <i class="fas fa-trash me-2"></i>Delete Event
            </button>
          </form>

          <a href="/dashboard/admin/event/<%= event._id %>/registrations" class="btn btn-info">
            <i class="fas fa-users me-2"></i>View Registrations
          </a>
        <% } %>
        
        <a href="/events" class="btn btn-primary">
          <i class="fas fa-arrow-left me-2"></i>Back to Events
        </a>
      </div>
    </div>
  </div>
</div>

<!-- URL cleanup after alert display -->
<% if ((typeof success !== 'undefined' && success) || (typeof error !== 'undefined' && error)) { %>
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.location.search) {
        window.history.replaceState({}, document.title, window.location.pathname);
      }
    });
  </script>
<% } %>